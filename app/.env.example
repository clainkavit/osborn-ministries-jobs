# Stage 21 section 5. Fill these in from your Supabase project dashboard:
#   Project Settings -> API
#
#   NEXT_PUBLIC_SUPABASE_URL          = the "Project URL"
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = the "anon / public" key
#   SUPABASE_SECRET_KEY              = the "service_role" key (click "Reveal")
#
# The secret key is server-only. It is NOT prefixed NEXT_PUBLIC_ on purpose,
# and must never be committed or shipped to the browser. This file is
# gitignored (see .gitignore).

NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME

NEXT_PUBLIC_APP_URL=http://localhost:3000
